name: Contract CI

on:
  push:
    paths:
      - 'schemas/**'
      - 'examples/**'
      - '.github/workflows/contracts.yml'
  pull_request:
    paths:
      - 'schemas/**'
      - 'examples/**'
      - '.github/workflows/contracts.yml'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: contract-ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate-contracts:
    name: Schemas / examples / receipt integrity
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Cache pip downloads
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-python312-jsonschema-v1
          restore-keys: |
            ${{ runner.os }}-python312-jsonschema-

      - name: Install validator
        run: python -m pip install 'jsonschema>=4.23,<5'

      - name: Validate schemas and examples
        shell: bash
        run: |
          python <<'PY'
          import hashlib
          import json
          import sys
          from pathlib import Path

          import jsonschema
          from jsonschema.validators import validator_for
          from referencing import Registry, Resource

          root = Path.cwd()
          schema_dir = root / "schemas"
          example_dir = root / "examples"

          if not schema_dir.is_dir():
              raise SystemExit("schemas/ is missing")
          if not example_dir.is_dir():
              raise SystemExit("examples/ is missing")

          schema_paths = sorted(schema_dir.glob("*.schema.json"))
          if not schema_paths:
              raise SystemExit("No schemas/*.schema.json files found")

          # The checked-in schemas intentionally omit $id. For validation only,
          # assign each schema its own file:// URI so relative $ref values resolve
          # completely offline against the local schemas/ directory.
          schemas = {}
          registry = Registry()

          for path in schema_paths:
              schema = json.loads(path.read_text(encoding="utf-8"))
              schema = dict(schema)
              schema["$id"] = path.resolve().as_uri()
              schemas[path.name] = schema

          for path in schema_paths:
              schema = schemas[path.name]
              registry = registry.with_resource(
                  schema["$id"], Resource.from_contents(schema)
              )

          for path in schema_paths:
              schema = schemas[path.name]
              cls = validator_for(schema)
              cls.check_schema(schema)
              cls(schema, registry=registry)
              print(f"schema PASS  {path.name}")

          def schema_for_example(name: str) -> str:
              if "rii-basis" in name:
                  return "rii-basis.schema.json"
              if "rii-assessment" in name:
                  return "rii-update-assessment.schema.json"
              mapping = {
                  "03-imported-success-input.json": "cross-unit-evidence-input.schema.json",
                  "04-cross-unit-evidence-normalized.json": "cross-unit-evidence.schema.json",
                  "07-imported-pilot-binding.json": "imported-pilot-binding.schema.json",
                  "08-local-outcome-after-imported-pilot.json": "local-outcome-evidence.schema.json",
                  "13-receipt-envelope-cross-unit.json": "receipt-envelope.schema.json",
              }
              try:
                  return mapping[name]
              except KeyError as exc:
                  raise SystemExit(
                      f"No schema mapping for examples/{name}; update Contract CI when adding a new example contract."
                  ) from exc

          valid_examples = sorted(example_dir.glob("*.json"))
          if not valid_examples:
              raise SystemExit("No examples/*.json files found")

          for path in valid_examples:
              schema_name = schema_for_example(path.name)
              schema = schemas[schema_name]
              cls = validator_for(schema)
              validator = cls(schema, registry=registry)
              instance = json.loads(path.read_text(encoding="utf-8"))
              validator.validate(instance)
              print(f"example PASS {path.name} -> {schema_name}")

          invalid_path = example_dir / "invalid" / "imported-direct-boundary-update.INVALID.json"
          if not invalid_path.is_file():
              raise SystemExit(f"Expected negative example is missing: {invalid_path}")

          invalid_schema = schemas["rii-update-assessment.schema.json"]
          invalid_validator = validator_for(invalid_schema)(invalid_schema, registry=registry)
          invalid_instance = json.loads(invalid_path.read_text(encoding="utf-8"))

          try:
              invalid_validator.validate(invalid_instance)
          except jsonschema.ValidationError as exc:
              print(f"negative PASS {invalid_path.name} was rejected: {exc.message}")
          else:
              raise SystemExit(
                  "Negative contract example unexpectedly validated: imported evidence must not enable direct boundary update"
              )

          # Computational integrity check for the portable receipt example.
          # Mirrors src/receipts/integrity.ts:
          # record_sha256 = SHA256(canonical_json(unsigned_receipt))
          receipt_path = example_dir / "13-receipt-envelope-cross-unit.json"
          receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
          unsigned = {
              "schema_version": receipt["schema_version"],
              "receipt_id": receipt["receipt_id"],
              "recorded_at": receipt["recorded_at"],
              "kind": receipt["kind"],
              "payload": receipt["payload"],
              "integrity": {"prev_hash": receipt["integrity"]["prev_hash"]},
          }
          canonical = json.dumps(
              unsigned,
              ensure_ascii=False,
              sort_keys=True,
              separators=(",", ":"),
          )
          actual = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
          expected = receipt["integrity"]["record_sha256"]
          if actual != expected:
              raise SystemExit(
                  f"Receipt hash mismatch: expected={expected} actual={actual}"
              )
          print(f"receipt PASS {receipt_path.name} sha256={actual}")

          print(
              f"Contract CI OK: {len(schema_paths)} schemas, "
              f"{len(valid_examples)} positive examples, 1 negative example, 1 receipt hash"
          )
          PY
